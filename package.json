{
  "name": "bearcode",
  "version": "2.0.1",
  "overrides": {
    "dompurify": "^3.4.16",
    "protobufjs": "^7.6.3",
    "uuid": "^11.1.1",
    "undici@6": "6.28.0",
    "undici@7": "7.29.1",
    "brace-expansion@1": "1.1.18",
    "brace-expansion@2": "2.1.6",
    "fast-uri": "3.1.6",
    "ip-address": "10.7.4",
    "hono": "4.13.13",
    "@hono/node-server": "2.0.10",
    "sharp": "0.35.5",
    "js-yaml@4": "4.3.2",
    "better-sqlite3": "^13.0.3",
    "undici@8": "8.10.2"
  },
  "description": "BearCode: a desktop agent manager",
  "main": "./out/main/index.js",
  "author": "Zach Rossmiller",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "postinstall": "patch-package && electron-builder install-app-deps",
    "test": "vitest run",
    "test:electron:browser": "electron-vite build && electron out/main/browserHarness.js",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win",
    "build:mac": "electron-vite build && electron-builder --mac",
    "build:mac:publish": "electron-vite build && electron-builder --mac --publish always",
    "build:linux": "electron-vite build && electron-builder --linux"
  },
  "dependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@langchain/anthropic": "^1.5.12",
    "@langchain/core": "^1.2.17",
    "@langchain/google-genai": "^2.3.2",
    "@langchain/langgraph": "^1.4.21",
    "@langchain/langgraph-checkpoint-sqlite": "^1.0.4",
    "@langchain/mcp-adapters": "^1.1.3",
    "@langchain/ollama": "^1.3.0",
    "@langchain/openai": "^1.6.2",
    "@radix-ui/react-avatar": "^1.2.7",
    "@radix-ui/react-dialog": "^1.2.0",
    "@radix-ui/react-dropdown-menu": "^2.1.25",
    "@radix-ui/react-label": "^2.1.16",
    "@radix-ui/react-popover": "^1.2.0",
    "@radix-ui/react-scroll-area": "^1.3.0",
    "@radix-ui/react-separator": "^1.1.16",
    "@radix-ui/react-slot": "^1.4.0",
    "@radix-ui/react-switch": "^1.3.8",
    "@radix-ui/react-tabs": "^1.1.22",
    "@radix-ui/react-tooltip": "^1.3.0",
    "@vscode/ripgrep": "^1.18.0",
    "@xenova/transformers": "^2.17.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "baseline-browser-mapping": "^2.11.28",
    "better-sqlite3": "^13.0.3",
    "browserslist": "^4.29.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "deepagents": "^1.14.2",
    "diff": "^9.0.0",
    "docx": "^9.9.0",
    "electron-updater": "^6.8.9",
    "exceljs": "^4.4.0",
    "http-cache-semantics": "^4.3.0",
    "langchain": "^1.5.16",
    "lucide-react": "^1.55.0",
    "mammoth": "^1.13.0",
    "monaco-editor": "^0.57.0",
    "node-pty": "^1.1.0",
    "pdf-lib": "^1.17.1",
    "playwright": "^1.64.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "unpdf": "^1.8.1",
    "ws": "^8.22.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.1",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^5.1.1",
    "electron": "^43.7.9",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "jsdom": "^30.1.2",
    "patch-package": "^8.0.1",
    "postinstall-postinstall": "^2.1.0",
    "prettier": "^3.9.10",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.0",
    "vite": "^7.2.6",
    "vitest": "^4.1.11"
  }
}
